NODE_ENV=development
PORT=3000
# Leave DATABASE_URL empty locally to use persistent PGlite in work/local-db.
DATABASE_URL=
# Optional for a standalone simulated preview: persist chart recovery snapshots hourly.
# Prices and alert evaluation still update on each tick; transient candles can reset on restart.
SIMULATION_CHECKPOINT_MS=
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
MARKET_DATA_PROVIDER=simulated
MARKET_DATA_MARKET=NSE,BSE
MARKET_DATA_REDISPLAY_APPROVED=false
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
# DhanHQ v2 is a server-only market data source. Do not commit credentials.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional equity universe; defaults to 12 NSE/BSE listings. Max 100 symbols.
# DHAN_SYMBOLS=NSE:RELIANCE,NSE:TCS,BSE:INFY
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v23.0

# Canonical application URL; use the public HTTPS Render URL in production.
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# Use a sender on your verified Resend domain, e.g. ChartPulse <alerts@example.com>.
EMAIL_FROM=
# Alert emails stay simulated by default. Verification emails require Resend.
EMAIL_SEND_IN_SIMULATION=false

# Distributed roles require PostgreSQL; Redis enables cross-service push delivery.
SERVICE_ROLE=standalone
REDIS_URL=
LEADER_DATABASE_URL=
DB_POOL_MAX=10
PG_SSL=
PG_SSL_REJECT_UNAUTHORIZED=true
# Optional trusted database CA file, or same-instance external Render host.
PG_CA_FILE=
PG_PUBLIC_HOST=
PG_LEADER_PUBLIC_HOST=
STREAM_URL=
ALLOWED_ORIGINS=
ALERT_SHARDS=1
ALERT_SHARD=0
MAX_GATEWAY_CONNECTIONS=10000
SOCKET_BUFFER_LIMIT=262144
MAX_PENDING_TICKS=10000
KAFKA_BROKERS=
KAFKA_MARKET_TOPIC=chartpulse-market
KAFKA_SSL=true
KAFKA_USERNAME=
KAFKA_PASSWORD=
